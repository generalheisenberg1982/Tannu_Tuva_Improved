@METER_X = 28
@KURUL_Y = 34
@PUBLIC_Y = 138
@LABEL_X = 28
@LABEL_WIDTH = 440

guiTypes = {

	containerWindowType = {
		name = "TAN_Toka_Consolidating_Power_GUI_window"
		position = { x = 0 y = 0 }
		size = { width = 100% height = 240 }

		instantTextBoxType = {
			name = "TAN_little_kurul_support_label"
			position = { x = @LABEL_X y = 10 }
			font = "hoi_18mbs"
			text = TAN_little_kurul_support_label
			format = left
			maxWidth = @LABEL_WIDTH
		}

		iconType = {
			name = "TAN_little_kurul_support_meter"
			spriteType = "GFX_TAN_Little_Kurul_Support"
			position = { x = @METER_X y = @KURUL_Y }
			frame = 2
			pdx_tooltip = TAN_little_kurul_support_meter_tt
		}

		instantTextBoxType = {
			name = "TAN_public_support_label"
			position = { x = @LABEL_X y = 112 }
			font = "hoi_18mbs"
			text = TAN_public_support_label
			format = left
			maxWidth = @LABEL_WIDTH
		}

		iconType = {
			name = "TAN_public_support_meter"
			spriteType = "GFX_TAN_Public_Support"
			position = { x = @METER_X y = @PUBLIC_Y }
			frame = 2
			pdx_tooltip = TAN_public_support_meter_tt
		}
	}

}
